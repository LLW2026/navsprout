# 示例值；运行 scripts/setup.py 会生成真正的配置，保存在 .env（0600）。
NAV_PORT=8866
NAV_BIND_IP=0.0.0.0
NAV_UID=10001
NAV_GID=10001
NAV_USERNAME=admin
NAV_PASSWORD_HASH='replace-with-argon2id-hash'
NAV_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
NAV_API_TOKEN=replace-with-dedicated-token-at-least-32-characters
NAV_DB=/data/nav.db
NAV_SESSION_DAYS=30
NAV_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10,nav.example.com
NAV_HTTPS_HOSTS=nav.example.com
NAV_ALLOWED_ORIGINS=http://localhost:8866,http://127.0.0.1:8866,http://192.168.1.10:8866,https://nav.example.com

# 每天北京时间定时从网络获取新背景，缓存持久保存在数据目录
NAV_BACKGROUND_ENABLED=true
NAV_BACKGROUND_REFRESH_TIME=06:00
